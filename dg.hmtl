    <nav class="navbar">
      <a href="../index.html" class="brand">MON PORTFOLIO NUMÉRIQUE</a>
      <ul class="nav-links">
        <li><a href="../index.html">Accueil</a></li>
        <li><a href="cybersecurite.html" class="active">Digital Skills</a></li>
        <li><a href="../developpement/python.html">Développement</a></li>
        <li><a href="../systemes/systemes-exploitation.html">Systèmes</a></li>
        <li><button id="theme-toggle" class="theme-btn" type="button">🌙 Mode Sombre</button></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- Section 1 : Cybersécurité -->
    <section class="module-section">
      <h1 class="module-header">🔒 Chapitre 1 : Se protéger sur Internet</h1>

      <div class="two-col-grid">
        <!-- Infographie / Bonnes pratiques -->
        <div class="panel">
          <div class="panel-header">INFOGRAPHIE : BONNES PRATIQUES DE SÉCURITÉ</div>
          <div class="panel-body">
            <div class="infographic-grid">
              <div class="info-item">
                <strong>🔑 Mots de passe</strong>
                Utiliser un mot de passe long, unique et un gestionnaire[cite: 4].
              </div>
              <div class="info-item">
                <strong>📱 Double facteur (2FA)</strong>
                Activer la vérification en deux étapes sur tous les comptes[cite: 4].
              </div>
              <div class="info-item">
                <strong>🔄 Mises à jour</strong>
                Maintenir le système et les logiciels à jour[cite: 4].
              </div>
              <div class="info-item">
                <strong>🎣 Vigilance Phishing</strong>
                Vérifier l'expéditeur avant de cliquer sur un lien[cite: 4].
              </div>
              <div class="info-item">
                <strong>🛡️ Antivirus</strong>
                Protéger ses appareils contre les malwares et ransomwares[cite: 3, 4].
              </div>
            </div>
          </div>
        </div>

        <!-- Checklist interactive -->
        <div class="panel">
          <div class="panel-header">CHECKLIST : SUIS-JE BIEN PROTÉGÉ ?</div>
          <div class="panel-body">
            <ul class="checklist">
              <li>
                <input type="checkbox" id="chk1">
                <label for="chk1">J'utilise des mots de passe différents pour chaque site[cite: 4].</label>
              </li>
              <li>
                <input type="checkbox" id="chk2">
                <label for="chk2">J'ai activé l'authentification à deux facteurs (2FA)[cite: 4].</label>
              </li>
              <li>
                <input type="checkbox" id="chk3">
                <label for="chk3">Je fais régulièrement les mises à jour de sécurité[cite: 4].</label>
              </li>
              <li>
                <input type="checkbox" id="chk4">
                <label for="chk4">J'évite les réseaux Wi-Fi publics sans précaution[cite: 4].</label>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2 : Prompt Engineering -->
    <section class="module-section">
      <h2 class="module-header">🤖 Chapitre 2 : Prompt Engineering (Cas Pratiques)</h2>

      <div class="cases-grid">
        <!-- Cas 1 -->
        <article class="case-card">
          <div class="case-header blue">CAS 1 : EXPLICATION D'UN COURS</div>
          <div class="case-body">
            <div class="case-row">
              <span class="case-label">Prompt initial (faible) :</span>
              « Explique-moi les pointeurs en C. »
            </div>
            <div class="case-row">
              <span class="case-label">Prompt amélioré (méthode) :</span>
              « Agis comme un professeur d'informatique. Explique les pointeurs en langage C à un étudiant de 1ère année avec une analogie simple et un exemple commenté de 10 lignes. »
            </div>
            <div class="case-row">
              <span class="case-label">Analyse :</span>
              L'ajout du rôle, du niveau et d'un format précis rend la réponse beaucoup plus claire et structurée[cite: 4].
            </div>
          </div>
        </article>

        <!-- Cas 2 -->
        <article class="case-card">
          <div class="case-header orange">CAS 2 : DÉBOGAGE DE CODE</div>
          <div class="case-body">
            <div class="case-row">
              <span class="case-label">Prompt initial (faible) :</span>
              « Mon code Python ne marche pas, corrige-le. »
            </div>
            <div class="case-row">
              <span class="case-label">Prompt amélioré (méthode) :</span>
              « Voici ma fonction de tri en Python et l'erreur affichée. Indique-moi la ligne qui pose problème et explique la cause sans réécrire tout le code. »
            </div>
            <div class="case-row">
              <span class="case-label">Analyse :</span>
              Le contexte et la contrainte pédagogique permettent de comprendre l'erreur au lieu de copier-coller[cite: 2, 4].
            </div>
          </div>
        </article>

        <!-- Cas 3 -->
        <article class="case-card">
          <div class="case-header purple">CAS 3 : RÉVISION &amp; QUIZ</div>
          <div class="case-body">
            <div class="case-row">
              <span class="case-label">Prompt initial (faible) :</span>
              « Fais un quiz sur Linux. »
            </div>
            <div class="case-row">
              <span class="case-label">Prompt amélioré (méthode) :</span>
              « Crée un QCM de 5 questions sur les commandes de base du terminal Linux (ls, cd, mkdir, chmod) avec les réponses et une brève justification à la fin. »
            </div>
            <div class="case-row">
              <span class="case-label">Analyse :</span>
              Délimiter le périmètre et le format de sortie produit un support de révision ciblé[cite: 4].
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Fiche Transparence IA obligatoire -->
    <aside class="ai-transparency">
      <div class="ai-badge">Transparence IA</div>
      <div class="ai-details">
        <p><strong>Outils utilisés :</strong> Perplexity, Claude, Canva[cite: 1, 2, 4].</p>
        <p><strong>Rôle de l'IA :</strong> Recherche de sources officielles, test comparatif de prompts et mise en page visuelle[cite: 1, 4, 8].</p>
        <p><strong>Ce que j'ai fait moi-même :</strong> Rédaction des analyses, sélection des bonnes pratiques et vérification des informations[cite: 2, 4, 8].</p>
        <p><strong>Sources vérifiées :</strong> ANSSI (ssi.gouv.fr), Cybermalveillance.gouv.fr[cite: 4, 8].</p>
      </div>
    </aside>
  </main>

